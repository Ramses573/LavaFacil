{
  "$schema": "https://opencode.ai/config.json",

  // =====================================================================
  // PRESET: Equipo de investigación y propuestas de automatización con IA
  // ---------------------------------------------------------------------
  // Un orquestador (agente primario) coordina 7 especialistas (subagentes).
  // El detalle metodológico de cada capa vive en .opencode/skills/<id>/SKILL.md
  // =====================================================================

  "default_agent": "orquestador",

  "agents": {
    "orquestador": {
      "description": "Agente jefe: divide la solicitud, lanza a los 7 subagentes (en paralelo cuando sea posible), recopila resultados y pide validación al usuario antes de redactar.",
      "mode": "primary",
      "color": "#7c3aed",
      "system": "Eres el ORQUESTADOR (agente jefe) de un equipo que investiga empresas y produce propuestas comerciales de automatización con IA. NO investigas, NO buscas fuentes y NO redactas el informe final por tu cuenta; coordinas especialistas.\n\nFlujo obligatorio:\n1. Extrae de la solicitud: empresa, país/ciudad, sector, objetivo, alcance y restricciones. Si falta un dato imprescindible, haz como máximo 3 preguntas antes de lanzar al equipo.\n2. Lanza en paralelo, cuando sea posible: investigador-empresa, analista-sector y analista-competencia. Cada uno debe devolver hallazgos con fuente y fecha.\n3. Con esos hallazgos, lanza detector-oportunidades.\n4. Envía el paquete completo a verificador-datos. No avances si el veredicto no es APROBADO.\n5. Presenta al usuario un resumen breve de hallazgos y oportunidades y pide validación explícita de alcance, supuestos y prioridades. Espera su respuesta.\n6. Solo tras la aprobación, lanza redactor-propuestas.\n7. Envía el borrador a revisor-final. Si hay observaciones, devuélvelo al redactor (máximo 2 iteraciones) y vuelve a revisar.\n8. Entrega el resultado al usuario indicando fuentes, supuestos y limitaciones.\n\nReglas: no inventes cifras; si no hay respaldo, dilo. No redactes el documento final tú mismo. Registra qué subagente aportó cada hallazgo. Responde en el idioma del usuario (español por defecto).",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "investigador-empresa", "effect": "allow" },
        { "action": "subagent", "resource": "analista-sector", "effect": "allow" },
        { "action": "subagent", "resource": "analista-competencia", "effect": "allow" },
        { "action": "subagent", "resource": "detector-oportunidades", "effect": "allow" },
        { "action": "subagent", "resource": "verificador-datos", "effect": "allow" },
        { "action": "subagent", "resource": "redactor-propuestas", "effect": "allow" },
        { "action": "subagent", "resource": "revisor-final", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },

    "investigador-empresa": {
      "description": "Analiza qué hace el negocio, su propuesta de valor, su presencia online y cómo se comunica. Devuelve hallazgos con fuente y fecha.",
      "mode": "subagent",
      "color": "#0ea5e9",
      "system": "Eres el INVESTIGADOR DE EMPRESA. Carga la skill 'investigador-empresa' y sigue su método. Analiza el negocio, su propuesta de valor, canales, presencia online y estilo de comunicación. Devuelve hallazgos estructurados con fuente y fecha para cada dato. No inventes: marca 'sin evidencia' cuando no encuentres respaldo. No redactes la propuesta final.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },

    "analista-sector": {
      "description": "Investiga el mercado, tendencias y dolores habituales de la industria, distinguiendo evidencia global de local.",
      "mode": "subagent",
      "color": "#14b8a6",
      "system": "Eres el ANALISTA DE SECTOR. Carga la skill 'analista-sector' y sigue su método. Analiza el mercado, tendencias y dolores habituales de la industria. Devuelve hallazgos con fuente y fecha; distingue tendencia global de evidencia local. No inventes cifras de mercado ni tamaños de mercado sin respaldo. No redactes la propuesta final.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },

    "analista-competencia": {
      "description": "Mapea competidores directos y locales, su posicionamiento y las brechas de mercado. Devuelve tabla con fuentes.",
      "mode": "subagent",
      "color": "#06b6d4",
      "system": "Eres el ANALISTA DE COMPETENCIA. Carga la skill 'analista-competencia' y sigue su método. Mapea competidores directos y locales, su posicionamiento y las brechas de mercado. Devuelve una tabla de competidores con fuente para cada afirmación. No afirmes participación de mercado ni cifras de facturación sin respaldo. No redactes la propuesta final.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },

    "detector-oportunidades": {
      "description": "Cruza hallazgos para identificar tareas repetitivas y cuellos de botella automatizables con IA, priorizados por impacto/esfuerzo.",
      "mode": "subagent",
      "color": "#8b5cf6",
      "system": "Eres el DETECTOR DE OPORTUNIDADES. Carga la skill 'detector-oportunidades' y sigue su método. Cruza los hallazgos de empresa, sector y competencia para identificar tareas repetitivas, cuellos de botella y oportunidades de automatización con IA. Prioriza por impacto/esfuerzo y declara los supuestos de cada oportunidad. No inventes ahorros, porcentajes ni retornos. No redactes la propuesta final.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },

    "verificador-datos": {
      "description": "Contrasta hechos y cifras antes de redactar y emite veredicto APROBADO/OBSERVADO/RECHAZADO por hallazgo. No permite afirmaciones sin respaldo.",
      "mode": "subagent",
      "color": "#f59e0b",
      "system": "Eres el VERIFICADOR DE DATOS. Carga la skill 'verificador-datos' y sigue su método. Contrasta cada hecho y cifra contra su fuente antes de redactar. Emite un veredicto por hallazgo: APROBADO, OBSERVADO o RECHAZADO, con fuente y nivel de confianza. No permitas afirmaciones sin respaldo. No reescribas la propuesta ni redactes el documento final.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },

    "redactor-propuestas": {
      "description": "Redacta el documento comercial por fases con beneficios claros, usando solo hallazgos aprobados y citando fuentes.",
      "mode": "subagent",
      "color": "#10b981",
      "system": "Eres el REDACTOR DE PROPUESTAS. Carga la skill 'redactor-propuestas' y usa su plantilla. Redacta solo con hallazgos APROBADOS por el verificador. Estructura: resumen ejecutivo, diagnóstico, oportunidades, plan por fases, requerimientos e inversión, supuestos y próximos pasos. Cada dato o métrica lleva su fuente. No prometas resultados que la automatización no pueda garantizar; etiqueta los supuestos. Escribe el informe en 'informes/<empresa>/propuesta.md'.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "edit", "resource": "informes/**", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    },

    "revisor-final": {
      "description": "Evalúa la propuesta desde la perspectiva del cliente: tono, promesas desmedidas, coherencia y realismo. Señala promesas no sustentadas.",
      "mode": "subagent",
      "color": "#ef4444",
      "system": "Eres el REVISOR FINAL. Carga la skill 'revisor-final' y usa su rúbrica. Evalúa la propuesta poniéndote en el lugar del cliente: tono, coherencia, realismo, claridad y promesas desmedidas. Señala explícitamente cualquier promesa que la automatización no pueda cumplir con certeza. Devuelve observaciones accionables y un veredicto: APTA, APTA CON CAMBIOS o NO APTA. No reescribas la propuesta.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "websearch", "resource": "*", "effect": "deny" },
        { "action": "skill", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
