    "description": "Colección completa para la defensa del Proyecto 2 de Bases de Datos Avanzadas (LavaFácil). Incluye Login con guardado automático de Token JWT, Consultas Públicas, Consultas Protegidas de las 10 tablas y Operaciones CRUD con Procedimientos Almacenados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5125/graphql",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Autenticación y Roles",
      "description": "Mutaciones de Login para validar credenciales y obtener el rol del usuario.",
      "item": [
        {
          "name": "1.1 Login Administrador (Guarda Token Automático)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.login && jsonData.data.login.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.login.token);",
                  "    pm.test('Login exitoso con rol Administrador', function () {",
                  "        pm.expect(jsonData.data.login.exito).to.eql(true);",
                  "        pm.expect(jsonData.data.login.rol).to.eql('Administrador');",
                  "    });",
                  "    console.log('Token JWT capturado y guardado automáticamente en {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginAdmin {\n  login(usuario: \"admin_p2_01\", clave: \"DemoTemporal2026!3\") {\n    exito\n    mensaje\n    rol\n    idUsuario\n    token\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Valida credenciales contra usp_ValidarLogin, confirma rol Administrador y guarda el Token en la variable de colección {{token}} automáticamente."
          }
        },
        {
          "name": "1.2 Login Cliente (Prueba Rol Cliente)",
          "request": {
            "method": "POST",
            "header": [
