                "query": "mutation CrearServicioPrueba {\n  insertarServicio(\n    nombreServicio: \"Lavado Express Postman\",\n    descripcion: \"Insertado desde la colección de Postman\",\n    tipoCobro: \"Unidad\",\n    precioBase: 3500,\n    cantidadIncluida: 1,\n    precioAdicional: 0\n  ) {\n    exito\n    mensaje\n  }\n}",
