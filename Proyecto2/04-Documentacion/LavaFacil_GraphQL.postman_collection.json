            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginCliente {\n  login(usuario: \"cliente_p2_01\", clave: \"DemoTemporal2026!1\") {\n    exito\n    mensaje\n    rol\n    idUsuario\n    token\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
