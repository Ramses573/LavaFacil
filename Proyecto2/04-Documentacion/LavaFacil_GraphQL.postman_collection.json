            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginEmpleado {\n  login(usuario: \"empleado_p2_01\", clave: \"DemoTemporal2026!2\") {\n    exito\n    mensaje\n    rol\n    idUsuario\n    token\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Demuestra la validación de un usuario con Rol Empleado."
          }
        },
        {
          "name": "1.4 Login Cuenta Principal (Ramses Aguilar)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.login && jsonData.data.login.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.login.token);",
                  "    pm.test('Login exitoso cuenta Ramses', function () {",
                  "        pm.expect(jsonData.data.login.exito).to.eql(true);",
                  "        pm.expect(jsonData.data.login.rol).to.eql('Administrador');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation LoginRamses($usuario: String!, $clave: String!) {\n  login(usuario: $usuario, clave: $clave) {\n    exito\n    mensaje\n    rol\n    token\n  }\n}",
                "variables": ""
              }
            },
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Login con la cuenta administradora de Ramsés."
          }
        }
      ]
    },
